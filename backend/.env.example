# Database (MAMP MySQL)
DATABASE_URL="mysql://root:root@localhost:3306/ai_study_coach"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"

# AI Providers (Choose one or more - all have free options!)

# Option 1: OpenAI (Free $5 credits for new accounts)
OPENAI_API_KEY="your-openai-api-key-here"

# Option 2: Google Gemini (60 requests/minute free)
GEMINI_API_KEY="your-gemini-api-key-here"

# Option 3: Hugging Face (Free inference API)
HUGGINGFACE_API_KEY="your-huggingface-api-key-here"

# Option 4: Ollama (Completely free, runs locally)
# No API key needed - just install Ollama and run: ollama run llama2

# Server
PORT=3001
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:3000"