generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   @db.Text
  name      String
  fieldOfStudy StudyField
  level     LearningLevel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  chatSessions ChatSession[]
  studyPlans   StudyPlan[]
  quizAttempts QuizAttempt[]
  codeSubmissions CodeSubmission[]
  progress     Progress[]

  @@map("users")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id            String   @id @default(cuid())
  sessionId     String
  role          MessageRole
  content       String   @db.Text
  timestamp     DateTime @default(now())

  // Relations
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model StudyPlan {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  subject     Subject
  difficulty  LearningLevel
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks StudyTask[]

  @@map("study_plans")
}

model StudyTask {
  id          String   @id @default(cuid())
  planId      String
  title       String
  description String   @db.Text
  subject     Subject
  difficulty  LearningLevel
  estimatedMinutes Int
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  order       Int
  createdAt   DateTime @default(now())

  // Relations
  plan StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("study_tasks")
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  subject     Subject
  difficulty  LearningLevel
  questions   Json     // Array of question objects
  createdAt   DateTime @default(now())

  // Relations
  attempts QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  answers     Json     // User's answers
  score       Float
  totalQuestions Int
  completedAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model CodingProblem {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  difficulty  LearningLevel
  language    ProgrammingLanguage
  testCases   Json     // Array of test case objects
  solution    String?  @db.Text // Optional reference solution
  createdAt   DateTime @default(now())

  // Relations
  submissions CodeSubmission[]

  @@map("coding_problems")
}

model CodeSubmission {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  code      String   @db.Text
  language  ProgrammingLanguage
  status    SubmissionStatus
  feedback  String?  @db.Text
  score     Float?
  submittedAt DateTime @default(now())

  // Relations
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("code_submissions")
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  subject   Subject
  topic     String
  level     LearningLevel
  score     Float    // 0-100
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, topic])
  @@map("progress")
}

// Enums
enum StudyField {
  COMPUTER_SCIENCE
  SOFTWARE_ENGINEERING
  INFORMATION_TECHNOLOGY
  INFORMATION_SYSTEMS
  CYBERSECURITY
}

enum LearningLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Subject {
  PROGRAMMING_PYTHON
  PROGRAMMING_JAVA
  PROGRAMMING_JAVASCRIPT
  PROGRAMMING_CPP
  DATA_STRUCTURES
  ALGORITHMS
  DATABASES
  OPERATING_SYSTEMS
  COMPUTER_NETWORKS
  SOFTWARE_ENGINEERING
  CYBERSECURITY
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ProgrammingLanguage {
  PYTHON
  JAVA
  JAVASCRIPT
  CPP
  C
  CSHARP
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
}